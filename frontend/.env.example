# "Web application" OAuth client ID from Google Cloud Console.
# Must be the same value as GOOGLE_CLIENT_ID in the backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Only used by non-development builds. In development the app derives the API
# address from the Expo dev server (see src/api/config.js).
EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
