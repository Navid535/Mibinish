DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com

DATABASE_URL=postgresql://mibinish:CHANGE_ME@db-host:5432/mibinish

DJANGO_SECURE_SSL_REDIRECT=True
# Start small. Raise only after HTTPS is confirmed to work everywhere.
DJANGO_SECURE_HSTS_SECONDS=86400

DJANGO_LOG_LEVEL=INFO
# Error notification recipients, format: Name:email@example.com,Other:other@example.com
# DJANGO_ADMINS=

# Console backend just prints emails. Switch to
# django.core.mail.backends.smtp.EmailBackend once you have an SMTP provider.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_SERVER_EMAIL=noreply@example.com

# Optional. Leave empty to disable Sentry.
DJANGO_SENTRY_DSN=
