# Shared defaults, loaded first by every settings module.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

DJANGO_TIME_ZONE=UTC

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Path of the Django admin site. Keep it non-default in production; must end with "/".
DJANGO_ADMIN_URL=admin/

# "Web application" OAuth client ID from Google Cloud Console.
# Must be the same value as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=
